<%= link_to "New Post", new_post_path %>
<%= link_to "Home", posts_path%>
<%= link_to "Profile", user_path(current_user) %>
<%= link_to "Who to follow", users_path%>

<% @posts.each do |post| %>
    <div>
        <p> <%= image_tag post.user.profile_picture, alt: "Profile Picture", class: "small-avatar"%>
        <p> <%= post.user.email %> </p>

        <% existing_follow = current_user.active_follows.find_by(followed_id: post.user.id) %>

        <% if post.user != current_user%>
            <% if existing_follow %>
                <%= button_to "Following", follow_path(existing_follow), method: :delete %>
            <% else%>
                <%= button_to "Follow", follows_path, method: :post, params: {followed_id: post.user.id} %>
            <%end %>
        <% end%>

        <p> <%= post.content %> </p>
        <p> <%= post.created_at %> </p>

        <%=link_to "Reply", "#" %>

        <% existing_like = post.likes.find_by(user: current_user) %>
        <% if existing_like %>
            <%= button_to "❤️", like_path(existing_like), method: :delete %>
        <% else%>
            <%= button_to "🤍", likes_path, method: :post, params: {post_id: post.id} %>
        <% end %>

        <%= post.likes.count %>

        <%=link_to "Retweet", "#" %>

        <% if post.user_id == current_user.id %>
            <%= button_to "Delete", post_path(post), method: :delete %>
        <%end%>

        <%= form_with url: comments_path do |fc|%>
            <%= fc.text_area :content%>
            <%= fc.hidden_field :post_id, value: post.id%>
            <%= fc.submit "Comment"%>
        <%end%>

        <% post.comments.each do |comment|%>
            <p> <%= comment.user.email%> </p>
            <p> <%= comment.content%> </p>
            <p> <%= comment.created_at %> </p>
            <% if comment.user_id == current_user.id %>
                <%= button_to "Delete", comment_path(comment), method: :delete%>
            <% end %>
        <% end %>
    </div>
<%end%>

<%= button_to "Logout", destroy_user_session_path, method: :delete%>